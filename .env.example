# WordPress REST root (with /wp-json, no trailing slash)
NEXT_PUBLIC_WP_BASE=https://gomostaging.com/ssl/wp-json

# Default language code (must be in SUPPORTED_LANGS, src/config/index.js)
NEXT_PUBLIC_DEFAULT_LANG=en

# Public URL of this site (canonical URLs, sitemap, robots). Optional on Vercel — the
# production domain is used when unset.
SITE_URL=https://sslsite.vercel.app

# Must match HEADLESS_REVALIDATE_SECRET in wp-config.php
REVALIDATE_SECRET=change-me

# Must match HEADLESS_PREVIEW_SECRET in wp-config.php
PREVIEW_SECRET=change-me

# WordPress user + Application Password (Users → Profile → Application Passwords).
# Used for draft previews and the Redirection plugin's redirects.
WP_API_USER=
WP_API_PASS=

# Staging only: 0 = never cache WordPress responses (every request hits WP). Leave unset in production.
# WP_REVALIDATE_SECONDS=0
