# WordPress backend (no trailing slash)
WORDPRESS_URL=https://gomostaging.com/ssl

# URL of this Next.js site (sitemap, canonical URLs). Optional on Vercel — defaults to the production URL.
SITE_URL=https://www.example.com

# Must match HEADLESS_REVALIDATE_SECRET in wp-config.php
REVALIDATE_SECRET=change-me-long-random-string

# Must match HEADLESS_PREVIEW_SECRET in wp-config.php
PREVIEW_SECRET=change-me-another-long-random-string

# WordPress user + Application Password used ONLY for draft previews
# (Users → Profile → Application Passwords). Use an Editor-level user.
WORDPRESS_PREVIEW_USER=preview-bot
WORDPRESS_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Cache lifetime (seconds) as a safety net next to on-demand revalidation
WP_REVALIDATE_SECONDS=3600
